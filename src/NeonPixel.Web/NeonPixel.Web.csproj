<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="uSync" />
  </ItemGroup>

  <!--
    theme/Views is a sibling directory (git submodule, see Program.cs), not a descendant of this
    project. Content items outside the project cone don't get view-engine-relative paths for free,
    so LinkBase places them under a virtual "Views" folder: LinkBase + %(RecursiveDir) produces
    Link=Views\HomeContent.cshtml, Link=Views\Shared\_Layout.cshtml, etc. — matching what Umbraco's
    view engine looks up. Guarded by Exists() so a clone without submodule access still builds.
    theme/Views/_ViewImports.cshtml is excluded: it would collide (same virtual path) with this
    repo's own Views/_ViewImports.cshtml, which already applies to the whole Views/ tree (Razor's
    _ViewImports resolution is hierarchical, so the top-level one already covers the linked views).
  -->
  <ItemGroup Condition="Exists('..\..\theme\Views')">
    <Content Include="..\..\theme\Views\**\*.cshtml" Exclude="..\..\theme\Views\_ViewImports.cshtml" LinkBase="Views" />
  </ItemGroup>

  <!--
    Same reasoning and mechanism as theme/Views above, for theme/wwwroot's static assets
    (CSS/JS/images/fonts/video). These used to be served via a runtime PhysicalFileProvider
    in Program.cs pointing at a path computed relative to ContentRootPath — that only ever
    resolved correctly in local dev, where theme/ is a sibling of this project in the same
    repo checkout. In production the published app has no such sibling directory at all, so
    every theme asset request silently fell through to Umbraco's own routing (a real bug,
    only caught after the first live deploy — browsers blocked the response as a MIME-type
    mismatch under X-Content-Type-Options: nosniff). LinkBase="wwwroot" places these files
    at their normal web-root-relative paths in the publish output (e.g. wwwroot/css/main.css),
    served automatically by ASP.NET Core's default static-file handling — identically in
    local dev and production, no runtime path computation needed.
  -->
  <ItemGroup Condition="Exists('..\..\theme\wwwroot')">
    <!-- scss/** is SCSS source (see wwwroot/scss/main.scss), compiled to the
         .css it sits alongside via `npm run build` in the theme repo — never
         served itself, so excluded from what ships to production. -->
    <Content Include="..\..\theme\wwwroot\**\*" Exclude="..\..\theme\wwwroot\scss\**\*" LinkBase="wwwroot" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms.
      Default mirrors prior behaviour introduced in https://github.com/umbraco/Umbraco-CMS/pull/11276: enabled unless building on macOS without an explicit RuntimeIdentifier.
      To override:
        * Build/publish:  dotnet publish -p:UmbracoUseAppLocalIcu=false
        * Post-publish:   edit System.Globalization.AppLocalIcu in the published *.runtimeconfig.json
      Note: DOTNET_SYSTEM_GLOBALIZATION_APPLOCALICU is only honored when AppLocalIcu is absent from runtimeconfig.json
      (verified on .NET 10) — the general .NET 9 env-var-precedence rule does not apply to this knob, since it is
      resolved by the native host before the CLR boots. Use one of the two override paths above instead.
      Keep UmbracoAppLocalIcuVersion in sync with the referenced Microsoft.ICU.ICU4C.Runtime package version.
    -->
    <UmbracoUseAppLocalIcu Condition="'$(UmbracoUseAppLocalIcu)' == '' and ($(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx'))))">true</UmbracoUseAppLocalIcu>
    <UmbracoUseAppLocalIcu Condition="'$(UmbracoUseAppLocalIcu)' == ''">false</UmbracoUseAppLocalIcu>
    <UmbracoAppLocalIcuVersion Condition="'$(UmbracoAppLocalIcuVersion)' == ''">72.1.0.3</UmbracoAppLocalIcuVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UmbracoUseAppLocalIcu)' == 'true'">
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="$(UmbracoAppLocalIcuVersion)" />
  </ItemGroup>


  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>


</Project>
